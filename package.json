{
    "name": "raycasting-fps-v3",
    "version": "0.5.1",
    "description": "RayCasting FPS Game V0.5.1",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder",
        "dist:portable": "electron-builder --win portable --x64 --publish never"
    },
    "author": "Marcos Blanc",
    "license": "ISC",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0",
        "playwright-core": "1.51.1"
    },
    "build": {
        "appId": "com.raycasting.fps",
        "productName": "RayCaster",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "nsis",
            "signAndEditExecutable": false
        },
        "portable": {
            "artifactName": "Raycasting-Game-${version}-Windows-x64-Portable.exe"
        },
        "asar": false,
        "compression": "maximum",
        "files": [
            "main.js",
            "index.html",
            "package.json",
            "js/**/*",
            "css/**/*",
            "assets/**/*"
        ]
    }
}
