{
    "name": "raycasting-fps-v3",
    "version": "0.5.1",
    "description": "RayCasting FPS Game V0.5.1",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder"
    },
    "author": "Marcos Blanc",
    "license": "ISC",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0"
    },
    "build": {
        "appId": "com.raycasting.fps",
        "productName": "RayCaster",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "nsis"
        },
        "compression": "maximum",
        "files": [
            "**/*",
            "!dist/**/*",
            "!node_modules/**/*",
            "!.git/**/*",
            "!.gemini/**/*"
        ]
    }
}